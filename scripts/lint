#!/bin/bash
# Lint: rustfmt and clippy in the Rust image. The tracked files are streamed into the container as
# a tar on stdin (a bind mount comes up empty on CI agents whose Docker daemon cannot see the
# checkout), so nothing is reformatted in place; fix locally with `cargo fmt`.
# Usage: scripts/lint
set -e
REPO=$(cd "$(dirname "$0")/.." && pwd)
export COPYFILE_DISABLE=1   # macOS tar: no AppleDouble ._ files in the stream
RUST_IMAGE=rust:1.95.0      # keep equal to rust-toolchain.toml

echo "--- :rust: cargo fmt + clippy"
git -C "$REPO" ls-files -z | tar -C "$REPO" --null -T - -cf - \
  | docker run -i --rm --platform linux/amd64 "$RUST_IMAGE" sh -c \
    "mkdir /work && cd /work && tar -xf - && cargo fmt --check \
     && cargo clippy --all-targets --locked -- -D warnings"
